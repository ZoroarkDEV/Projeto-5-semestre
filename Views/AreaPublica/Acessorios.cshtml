@{
}

@model List<Carro>

<div class="container mt-4">
    <div class="row">

        @foreach (Carro Acessorios in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">

                    <div class="card-body">

                        <h5 class="card-title">
                            @Acessorios.Nome
                        </h5>
                        
                        <p class="card-text">
                            @Acessorios.Descricao
                        </p>

                        <p class="card-text">
                            <strong>Ano:</strong> @Acessorios.Ano
                        </p>

                        <p class="card-text">
                            <strong>Quilometragem:</strong> @Acessorios.Quilometragem km
                        </p>

                        <p class="card-text">
                            <strong>Câmbio:</strong> @Acessorios.Cambio
                        </p>

                        <p class="card-text">
                            <strong>Preço:</strong> R$ @Acessorios.Preco
                        </p>

                    </div>

                </div>
            </div>
        }

   </div>
</div>
